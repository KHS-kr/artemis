# ==============================================================================
# Artemis Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your API credentials:
# cp .env.example .env

# LLM Providers (Configure at least one)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPEN_ROUTER_API_KEY=
XAI_API_KEY=

# Alternative to API keys entirely: drive Artemis through a locally installed,
# signed-in coding-agent CLI and spend its subscription instead. Uncomment one
# (and see `artemis doctor` to verify):
#   ARTEMIS_LLM_CONFIG=config/llm-config.claude-cli.jsonc
#   ARTEMIS_LLM_CONFIG=config/llm-config.codex-cli.jsonc
# ARTEMIS_LLM_CONFIG=

# Required alongside a CLI backend. The Explorer's 'flash' tier is one-shot
# pixel grounding and needs a Gemini ER model; 'pro' derives coordinates from
# real accessibility-tree bounds, so it is the tier that works with no Google
# key. Do not use 'ultra' here - it re-exposes pixel detection and OCR.
# ARTEMIS_EXPLORER_VERSION=pro

# Artemis removes provider API keys from the CLI's environment so calls spend
# the subscription rather than switching to metered API billing. Set to 1 to
# inherit them instead (e.g. to point a CLI at a gateway).
# ARTEMIS_CLI_INHERIT_API_KEYS=0

# Hard timeout for one CLI-backed model call, overriding the per-backend floor
# (180s for claude, 600s for codex).
# ARTEMIS_CLI_TIMEOUT_S=

# Google Cloud Vision OCR (Optional - for advanced OCR processing)
OCR_API_KEY=

# Android ADB Connectivity (Optional - defaults to 127.0.0.1:5037)
ADB_HOST=127.0.0.1
ADB_PORT=5037
# ADB_DEVICE_SERIAL=
# Keep the display awake, falling back to a wake lock or safe heartbeat when needed.
# Set to false if Artemis is used with a personal device whose screen should time out.
ARTEMIS_KEEP_DEVICE_AWAKE=true
# UI hierarchy backend: auto (Accessibility Helper, UIAutomator2 fallback) | helper | uiautomator
ARTEMIS_HIERARCHY_BACKEND=auto
# Let tasks install / upgrade the Accessibility Helper APK on a device they hold.
# Set to false on shared or personal phones: then only `artemis helper install` installs it.
ARTEMIS_HELPER_AUTO_INSTALL=true

# Artemis Execution Defaults (flash or pro)
ARTEMIS_DEFAULT_PROFILE=flash
